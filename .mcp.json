{
  "mcpServers": {
    "feishu": {
      "command": "bun",
      "args": ["run", "--cwd", "/absolute/path/to/claude-channel-feishu", "--shell=bun", "--silent", "start"],
      "env": {
        "FEISHU_STATE_DIR": "/absolute/path/to/.claude/channels/feishu",
        "MCP_SERVER_NAME": "feishu"
      },
      "type": "stdio"
    }
  }
}
